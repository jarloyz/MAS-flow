  },
  "models": {},
  "disabled_agents": [],
  "claude_code": {
    "permissions": {
      "allow": [
        "Bash({masflow} status:*)",
        "Bash({masflow} check:*)",
        "Bash({masflow} stats:*)",
        "Bash({masflow} log:*)",
        "Bash({masflow} related-tests:*)",
        "Bash({masflow} checks:*)",
        "Bash({masflow} git create-branch:*)",
        "Bash({masflow} git commit-slice:*)",
        "Bash({masflow} git rollback-slice:*)",
        "Bash({masflow} git push-branch:*)",
        "Bash({masflow} git merge-story:*)",
        "Bash({masflow} verify:*)",
        "Bash({masflow} archive-story:*)",
        "Bash(git status:*)",
        "Bash(git diff:*)",
        "Bash(git log:*)",
        "Bash(git show:*)"
