  "projects": [
    {
      "name": "app",
      "path": ".",
      "description": "Main application.",
      "notes": [],
      "tests": {
        "preflight": [],
        "full": "cd {project} && npm test",
        "file": "cd {project} && npm test -- {file}",
        "filter": "cd {project} && npm test -- -t \"{filter}\""
      },
      "checks": [],
      "slice_checks": [],
      "acceptance": []
    }
  ],
  "environment": [
    "All commands run from the project directory with absolute paths."
  ],
  "command_guard": {
    "blocked": [],
